# Names only. Copy to .env and fill locally. Never commit .env.
APP_ENV=development
# Host tooling uses localhost; containers get a `postgres`-host override from compose.yaml.
DATABASE_URL=postgresql+psycopg://aiops:change-me@localhost:5432/aiops
SESSION_SECRET=
LLM_PROVIDER=cloud
LLM_API_KEY=
LLM_MODEL=
CA_KEY_PATH=./secrets/ca.key
CA_CERT_PATH=./secrets/ca.pem
POSTGRES_PASSWORD=change-me
